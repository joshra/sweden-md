---
import { getElectionVisualCards, localizeText, type ElectionLocale, type VisualNode } from "../data/electionVisualCards";

interface Props {
  slug: string;
  locale: ElectionLocale;
}

const { slug, locale } = Astro.props;
const cards = getElectionVisualCards(slug);
const isEnglish = locale === "en";
const seatDots = Array.from({ length: 48 });

function nodeLabel(node: VisualNode) {
  return localizeText({ zh: node.zh, en: node.en }, locale);
}
---

{cards.length > 0 && (
  <section class="visual-card-section" aria-label={isEnglish ? "Encyclopedic diagram cards" : "百科圖解卡"}>
    <div class="visual-card-head">
      <p class="eyebrow">{isEnglish ? "Encyclopedic diagrams" : "百科圖解"}</p>
      <p>
        {isEnglish
          ? "Each card is drawn with editable labels and a source note, so political facts stay checkable."
          : "每張卡都用可校對的標籤、圖例與來源註記繪製，讓政治事實留在可維護的圖解系統裡。"}
      </p>
    </div>

    <div class="visual-card-grid">
      {cards.map((card, cardIndex) => (
        <figure class={`visual-card diagram-${card.diagram}`}>
          <header class="figure-header">
            <span>{isEnglish ? `FIG. ${String(cardIndex + 1).padStart(2, "0")}` : `圖卡 ${String(cardIndex + 1).padStart(2, "0")}`}</span>
            <strong>{localizeText(card.eyebrow, locale)}</strong>
          </header>

          <div class="figure-body">
            <div class="diagram-panel" aria-hidden="true">
              <div class="diagram-grid"></div>
              <div class="plate-frame">
                <span class="corner corner-tl"></span>
                <span class="corner corner-tr"></span>
                <span class="corner corner-bl"></span>
                <span class="corner corner-br"></span>
                <span class="plate-stamp">SWEDEN 2026</span>
              </div>

              {card.diagram === "timeline" && (
                <div class="timeline-diagram">
                  <div class="timeline-track"></div>
                  {card.nodes.map((node, index) => (
                    <div class={`diagram-chip timeline-chip tone-${node.tone} pos-${index}`}>
                      <span>{String(index + 1).padStart(2, "0")}</span>
                      {nodeLabel(node)}
                    </div>
                  ))}
                </div>
              )}

              {card.diagram === "layers" && (
                <div class="layer-diagram">
                  {card.nodes.map((node, index) => (
                    <div class={`layer-slab tone-${node.tone} pos-${index}`}>
                      <span>{nodeLabel(node)}</span>
                    </div>
                  ))}
                </div>
              )}

              {(card.diagram === "flow" || card.diagram === "support") && (
                <div class="flow-diagram">
                  {card.nodes.map((node, index) => (
                    <div class={`flow-step tone-${node.tone}`}>
                      <span>{String(index + 1)}</span>
                      {nodeLabel(node)}
                    </div>
                  ))}
                </div>
              )}

              {card.diagram === "spectrum" && (
                <div class="spectrum-diagram">
                  <div class="spectrum-axis"></div>
                  {card.nodes.map((node, index) => (
                    <div class={`spectrum-marker tone-${node.tone} pos-${index}`}>
                      <span>{nodeLabel(node)}</span>
                    </div>
                  ))}
                </div>
              )}

              {(card.diagram === "parliament" || card.diagram === "majority") && (
                <div class="hemicycle-diagram">
                  <div class="majority-rule"></div>
                  <div class="seat-map">
                    {seatDots.map((_, dotIndex) => {
                      const node = card.nodes[dotIndex % card.nodes.length];
                      return <span class={`seat-dot tone-${node.tone}`}></span>;
                    })}
                  </div>
                  <div class="hemicycle-legend">
                    {card.nodes.map((node) => (
                      <span class={`legend-token tone-${node.tone}`}>{nodeLabel(node)}</span>
                    ))}
                  </div>
                </div>
              )}

              {card.diagram === "archive" && (
                <div class="archive-diagram">
                  {card.nodes.map((node, index) => (
                    <div class={`archive-folder tone-${node.tone} pos-${index}`}>{nodeLabel(node)}</div>
                  ))}
                </div>
              )}

              {card.diagram === "network" && (
                <div class="network-diagram">
                  <div class={`network-core tone-${card.nodes[0].tone}`}>{nodeLabel(card.nodes[0])}</div>
                  {card.nodes.slice(1).map((node, index) => (
                    <div class={`network-node tone-${node.tone} pos-${index}`}>{nodeLabel(node)}</div>
                  ))}
                  <span class="network-line line-0"></span>
                  <span class="network-line line-1"></span>
                  <span class="network-line line-2"></span>
                </div>
              )}

              {card.diagram === "axis" && (
                <div class="axis-diagram">
                  <span class="axis-x"></span>
                  <span class="axis-y"></span>
                  {card.nodes.map((node, index) => (
                    <div class={`axis-point tone-${node.tone} pos-${index}`}>{nodeLabel(node)}</div>
                  ))}
                </div>
              )}

              {card.diagram === "table" && (
                <div class="table-diagram">
                  <div class="table-surface"></div>
                  {card.nodes.map((node, index) => (
                    <div class={`table-seat tone-${node.tone} pos-${index}`}>{nodeLabel(node)}</div>
                  ))}
                </div>
              )}

              {card.diagram === "puzzle" && (
                <div class="puzzle-diagram">
                  {card.nodes.map((node, index) => (
                    <div class={`puzzle-piece tone-${node.tone} pos-${index}`}>{nodeLabel(node)}</div>
                  ))}
                </div>
              )}

              {card.diagram === "balance" && (
                <div class="balance-diagram">
                  <div class="scale-beam"></div>
                  <div class="scale-post"></div>
                  {card.nodes.map((node, index) => (
                    <div class={`scale-weight tone-${node.tone} pos-${index}`}>{nodeLabel(node)}</div>
                  ))}
                </div>
              )}

              {card.diagram === "bridge" && (
                <div class="bridge-diagram">
                  <div class="bridge-deck"></div>
                  {card.nodes.map((node, index) => (
                    <div class={`bridge-pillar tone-${node.tone} pos-${index}`}>{nodeLabel(node)}</div>
                  ))}
                </div>
              )}

              {card.diagram === "issueGrid" && (
                <div class="matrix-diagram">
                  {card.nodes.map((node, index) => (
                    <div class={`matrix-cell tone-${node.tone} pos-${index}`}>
                      <span>{nodeLabel(node)}</span>
                    </div>
                  ))}
                </div>
              )}

              {card.diagram === "threshold" && (
                <div class="threshold-diagram">
                  <div class="threshold-wall"></div>
                  {card.nodes.map((node, index) => (
                    <div class={`threshold-item tone-${node.tone} pos-${index}`}>{nodeLabel(node)}</div>
                  ))}
                </div>
              )}
            </div>

            <figcaption class="visual-copy">
              <p class="card-eyebrow">{localizeText(card.eyebrow, locale)}</p>
              <h2>{localizeText(card.title, locale)}</h2>
              <p>{localizeText(card.caption, locale)}</p>
              <div class="legend-row">
                {card.nodes.map((node) => (
                  <span class={`legend-token tone-${node.tone}`}>{nodeLabel(node)}</span>
                ))}
              </div>
              <small>{localizeText(card.sourceNote, locale)}</small>
            </figcaption>
          </div>
        </figure>
      ))}
    </div>
  </section>
)}

<style>
  .visual-card-section {
    margin: 0 0 34px;
  }

  .visual-card-head {
    max-width: 70ch;
    margin-bottom: 16px;
  }

  .visual-card-head p:last-child {
    margin: 0;
    color: var(--muted);
  }

  .visual-card-grid {
    display: grid;
    gap: 18px;
  }

  .visual-card {
    margin: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--page-accent) 22%, var(--line));
    border-radius: 10px;
    background:
      linear-gradient(180deg, rgba(255, 253, 248, 0.99), rgba(246, 239, 229, 0.96));
    box-shadow: 0 16px 34px rgba(31, 43, 34, 0.07);
  }

  .figure-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 48px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--page-accent) 10%, #fff9ef), #fffaf2);
  }

  .figure-header span,
  .figure-header strong,
  .card-eyebrow,
  .visual-copy small {
    color: var(--page-accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .figure-body {
    display: grid;
    grid-template-columns: minmax(260px, 0.95fr) minmax(0, 1fr);
    gap: 0;
  }

  .diagram-panel {
    position: relative;
    min-height: 280px;
    padding: 24px;
    border-right: 1px solid var(--line);
    background:
      radial-gradient(circle at 20% 18%, rgba(255, 255, 255, 0.72), transparent 24%),
      linear-gradient(180deg, #faf4ea, #f2eadc);
    overflow: hidden;
  }

  .diagram-panel::before {
    content: "";
    position: absolute;
    inset: 13px;
    border: 1px solid rgba(31, 43, 34, 0.14);
    pointer-events: none;
  }

  .diagram-grid {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(31, 43, 34, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(31, 43, 34, 0.04) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.9), rgba(0, 0, 0, 0.2));
    pointer-events: none;
  }

  .plate-frame {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  .corner {
    position: absolute;
    width: 24px;
    height: 24px;
    border-color: rgba(31, 43, 34, 0.32);
    border-style: solid;
  }

  .corner-tl {
    top: 13px;
    left: 13px;
    border-width: 2px 0 0 2px;
  }

  .corner-tr {
    top: 13px;
    right: 13px;
    border-width: 2px 2px 0 0;
  }

  .corner-bl {
    bottom: 13px;
    left: 13px;
    border-width: 0 0 2px 2px;
  }

  .corner-br {
    right: 13px;
    bottom: 13px;
    border-width: 0 2px 2px 0;
  }

  .plate-stamp {
    position: absolute;
    right: 20px;
    bottom: 18px;
    color: rgba(31, 43, 34, 0.36);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.16em;
  }

  .visual-copy {
    display: grid;
    align-content: center;
    gap: 10px;
    padding: 24px;
  }

  .visual-copy h2 {
    font-size: clamp(1.28rem, 2.4vw, 1.78rem);
    line-height: 1.16;
  }

  .visual-copy p,
  .visual-copy small {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .visual-copy small {
    color: var(--page-accent);
    letter-spacing: 0;
    text-transform: none;
  }

  .legend-row,
  .hemicycle-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .legend-token {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 5px 9px;
    border: 1px solid rgba(31, 43, 34, 0.16);
    border-radius: 5px;
    background: color-mix(in srgb, var(--tone-bg) 52%, #fff9ef);
    color: #1f2b22;
    font-size: 0.76rem;
    font-weight: 800;
    line-height: 1.15;
  }

  .tone-red { --tone-bg: #d56f61; }
  .tone-blue { --tone-bg: #739eb9; }
  .tone-green { --tone-bg: #8faa72; }
  .tone-yellow { --tone-bg: #d7b653; }
  .tone-neutral { --tone-bg: #d2c6b5; }

  .diagram-chip,
  .layer-slab,
  .flow-step,
  .spectrum-marker,
  .archive-folder,
  .network-core,
  .network-node,
  .axis-point,
  .table-seat,
  .puzzle-piece,
  .scale-weight,
  .bridge-pillar,
  .matrix-cell,
  .threshold-item {
    display: grid;
    place-items: center;
    min-width: 74px;
    min-height: 42px;
    padding: 8px 10px;
    border: 1px solid rgba(31, 43, 34, 0.2);
    border-radius: 7px;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--tone-bg) 68%, #fffaf2), color-mix(in srgb, var(--tone-bg) 50%, #f4ecdf));
    color: #1f2b22;
    font-size: 0.78rem;
    font-weight: 800;
    line-height: 1.14;
    text-align: center;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.42),
      0 8px 18px rgba(31, 43, 34, 0.09);
  }

  .timeline-diagram,
  .layer-diagram,
  .flow-diagram,
  .spectrum-diagram,
  .hemicycle-diagram,
  .archive-diagram,
  .network-diagram,
  .axis-diagram,
  .table-diagram,
  .puzzle-diagram,
  .balance-diagram,
  .bridge-diagram,
  .matrix-diagram,
  .threshold-diagram {
    position: relative;
    z-index: 1;
    width: 100%;
    min-height: 232px;
  }

  .timeline-track {
    position: absolute;
    left: 28px;
    right: 28px;
    top: 50%;
    height: 4px;
    border-radius: 999px;
    background: rgba(31, 43, 34, 0.26);
  }

  .timeline-chip {
    position: absolute;
    width: 82px;
  }

  .timeline-chip span {
    display: block;
    margin-bottom: 4px;
    color: rgba(31, 43, 34, 0.58);
    font-size: 0.68rem;
  }

  .timeline-chip.pos-0 { left: 0; top: 32px; }
  .timeline-chip.pos-1 { left: 28%; top: 138px; }
  .timeline-chip.pos-2 { left: 56%; top: 32px; }
  .timeline-chip.pos-3 { right: 0; top: 138px; }

  .layer-slab {
    position: absolute;
    left: 12%;
    right: 12%;
    height: 56px;
    border-radius: 8px;
    transform: skewY(-6deg);
  }

  .layer-slab.pos-0 { top: 22px; }
  .layer-slab.pos-1 { top: 74px; left: 8%; right: 8%; }
  .layer-slab.pos-2 { top: 126px; left: 4%; right: 4%; }
  .layer-slab.pos-3 { top: 178px; left: 0; right: 0; }

  .flow-diagram {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
    align-items: center;
  }

  .flow-step {
    position: relative;
    min-width: 0;
    min-height: 92px;
  }

  .flow-step span {
    display: block;
    margin-bottom: 6px;
    color: rgba(31, 43, 34, 0.58);
    font-size: 1.2rem;
  }

  .flow-step:not(:last-child)::after {
    content: "";
    position: absolute;
    right: -23px;
    top: 50%;
    width: 24px;
    height: 2px;
    background: rgba(31, 43, 34, 0.3);
  }

  .flow-step:not(:last-child)::before {
    content: "";
    position: absolute;
    right: -25px;
    top: calc(50% - 4px);
    border-left: 8px solid rgba(31, 43, 34, 0.3);
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
  }

  .spectrum-axis {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 52px;
    height: 5px;
    border-radius: 999px;
    background: linear-gradient(90deg, #d56f61, #d7b653, #8faa72, #739eb9);
  }

  .spectrum-marker {
    position: absolute;
    width: 90px;
    min-height: 72px;
    border-radius: 16px 16px 8px 8px;
  }

  .spectrum-marker.pos-0 { left: 0; bottom: 76px; }
  .spectrum-marker.pos-1 { left: 26%; bottom: 118px; }
  .spectrum-marker.pos-2 { right: 26%; bottom: 118px; }
  .spectrum-marker.pos-3 { right: 0; bottom: 76px; }

  .hemicycle-diagram {
    display: grid;
    align-content: center;
    gap: 14px;
  }

  .seat-map {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 6px;
    width: min(100%, 330px);
    margin: 0 auto;
    padding: 22px 18px 12px;
    border: 4px solid rgba(31, 43, 34, 0.18);
    border-top: 0;
    border-radius: 0 0 180px 180px;
  }

  .seat-dot {
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--tone-bg);
    box-shadow: inset 0 0 0 1px rgba(31, 43, 34, 0.14);
  }

  .majority-rule {
    position: absolute;
    top: 24px;
    bottom: 74px;
    left: 50%;
    width: 2px;
    background: rgba(31, 43, 34, 0.22);
  }

  .archive-diagram {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    align-content: center;
  }

  .archive-folder {
    min-height: 86px;
    justify-content: start;
    border-radius: 7px 18px 18px;
  }

  .archive-folder::before {
    content: "";
    width: 34px;
    height: 8px;
    margin-bottom: 8px;
    border-radius: 6px 6px 0 0;
    background: rgba(31, 43, 34, 0.18);
  }

  .network-core {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 104px;
    height: 104px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
  }

  .network-node {
    position: absolute;
    width: 112px;
  }

  .network-node.pos-0 { left: 0; top: 12px; }
  .network-node.pos-1 { right: 0; top: 14px; }
  .network-node.pos-2 { left: 50%; bottom: 0; transform: translateX(-50%); }

  .network-line {
    position: absolute;
    height: 2px;
    background: rgba(31, 43, 34, 0.22);
    transform-origin: left center;
  }

  .line-0 { left: 27%; top: 38%; width: 88px; transform: rotate(22deg); }
  .line-1 { right: 27%; top: 38%; width: 88px; transform: rotate(158deg); }
  .line-2 { left: 50%; bottom: 32%; width: 70px; transform: rotate(90deg); }

  .axis-x,
  .axis-y {
    position: absolute;
    background: rgba(31, 43, 34, 0.25);
  }

  .axis-x { left: 18px; right: 18px; top: 50%; height: 2px; }
  .axis-y { top: 18px; bottom: 18px; left: 50%; width: 2px; }

  .axis-point,
  .table-seat,
  .scale-weight,
  .bridge-pillar,
  .threshold-item {
    position: absolute;
    width: 108px;
  }

  .axis-point.pos-0 { left: 0; top: 10px; }
  .axis-point.pos-1 { right: 0; top: 10px; }
  .axis-point.pos-2 { left: 0; bottom: 10px; }
  .axis-point.pos-3 { right: 0; bottom: 10px; }

  .table-surface {
    position: absolute;
    inset: 64px 74px;
    border: 4px solid rgba(31, 43, 34, 0.18);
    border-radius: 999px;
    background: rgba(255, 250, 240, 0.68);
  }

  .table-seat.pos-0 { left: 50%; top: 4px; transform: translateX(-50%); }
  .table-seat.pos-1 { right: 0; top: 50%; transform: translateY(-50%); }
  .table-seat.pos-2 { left: 50%; bottom: 4px; transform: translateX(-50%); }
  .table-seat.pos-3 { left: 0; top: 50%; transform: translateY(-50%); }

  .puzzle-diagram,
  .matrix-diagram {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    align-content: center;
  }

  .puzzle-piece,
  .matrix-cell {
    min-height: 92px;
  }

  .puzzle-piece.pos-0 { border-radius: 26px 8px 18px 8px; }
  .puzzle-piece.pos-1 { border-radius: 8px 26px 8px 18px; transform: translateY(12px); }
  .puzzle-piece.pos-2 { border-radius: 8px 18px 8px 26px; transform: translateY(-12px); }
  .puzzle-piece.pos-3 { border-radius: 18px 8px 26px 8px; }

  .scale-beam {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 104px;
    height: 5px;
    border-radius: 999px;
    background: rgba(31, 43, 34, 0.28);
    transform: rotate(-3deg);
  }

  .scale-post {
    position: absolute;
    left: 50%;
    top: 92px;
    bottom: 24px;
    width: 4px;
    background: rgba(31, 43, 34, 0.2);
  }

  .scale-weight.pos-0 { left: 0; top: 34px; }
  .scale-weight.pos-1 { left: 20%; bottom: 28px; }
  .scale-weight.pos-2 { right: 20%; top: 28px; }
  .scale-weight.pos-3 { right: 0; bottom: 34px; }

  .bridge-deck {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 70px;
    height: 10px;
    border-radius: 999px;
    background: rgba(31, 43, 34, 0.25);
  }

  .bridge-pillar.pos-0 { left: 0; bottom: 22px; }
  .bridge-pillar.pos-1 { left: 27%; top: 36px; }
  .bridge-pillar.pos-2 { right: 27%; top: 36px; }
  .bridge-pillar.pos-3 { right: 0; bottom: 22px; }

  .matrix-cell {
    align-content: center;
    border-radius: 18px;
  }

  .threshold-wall {
    position: absolute;
    left: 50%;
    top: 18px;
    bottom: 18px;
    width: 12px;
    border-radius: 999px;
    background: repeating-linear-gradient(180deg, rgba(31, 43, 34, 0.28) 0 12px, transparent 12px 20px);
  }

  .threshold-item.pos-0 { left: 0; top: 32px; }
  .threshold-item.pos-1 { right: 0; top: 72px; }
  .threshold-item.pos-2 { left: 0; bottom: 36px; }

  @media (max-width: 820px) {
    .figure-body {
      grid-template-columns: 1fr;
    }

    .diagram-panel {
      min-height: 250px;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .flow-diagram {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .flow-step:not(:last-child)::before,
    .flow-step:not(:last-child)::after {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .figure-header,
    .legend-row,
    .hemicycle-legend {
      align-items: flex-start;
    }

    .figure-header {
      flex-direction: column;
      gap: 4px;
    }

    .diagram-panel {
      padding: 18px;
    }

    .diagram-chip,
    .layer-slab,
    .flow-step,
    .spectrum-marker,
    .archive-folder,
    .network-core,
    .network-node,
