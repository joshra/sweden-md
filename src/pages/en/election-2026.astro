---
import Layout from "../../layouts/Layout.astro";
import { electionArticleLinks, electionDate, electionIssues, electionParties, electionSources, t } from "../../data/election2026";
import { getArticle } from "../../utils/content";
import { withBase } from "../../utils/paths";
import ArticleVisualCards from "../../components/ArticleVisualCards.astro";

const locale = "en";
const articleCards = electionArticleLinks.map((item) => {
  const article = getArticle("en", "society", item.slug);
  return {
    ...item,
    href: article?.href || withBase(`/en/society/${item.slug}`)
  };
});
---

<Layout
  title="Sweden 2026 Election and Party Guide | Sweden.md"
  description="A bilingual guide to Sweden's 2026 election, eight Riksdag parties, campaign issues, and post-election government formation."
  lang="en"
  pageType="election"
>
  <section class="election-hero">
    <div class="hero-copy">
      <p class="eyebrow">Election 2026</p>
      <h1>Sweden's 2026 election is not a presidential race. It rearranges a governing puzzle.</h1>
      <p>
        On 13 September 2026, Sweden holds elections to the Riksdag, regions, and municipalities on the same day. This section uses six articles and eighteen encyclopedia-style diagram cards to explain the system, the parties, and why bargaining continues after election night.
      </p>
      <div class="button-row">
        <a class="button" href="#articles">Start reading</a>
        <a class="button secondary" href={withBase("/election-2026")}>中文</a>
      </div>
    </div>
    <aside class="date-panel" aria-label="2026 election date">
      <span>Election day</span>
      <strong>{electionDate}</strong>
      <p>Riksdag, regional, and municipal elections</p>
    </aside>
  </section>

  <section class="card">
    <div class="card-inner section-grid">
      <div>
        <p class="eyebrow">How To Read</p>
        <h2>Start with institutions, parties, then cabinet formation.</h2>
      </div>
      <p>
        Swedish politics is often flattened into "left versus right" or "welfare versus immigration". The more useful reading is that proportional representation keeps eight parties in play, and parties turn disagreement into governable arrangements through agreements, tolerance, and policy exchange.
      </p>
    </div>
  </section>

  <section class="diagram-preview">
    <ArticleVisualCards slug="election-2026-overview" locale="en" />
  </section>

  <section class="card">
    <div class="card-inner">
      <div class="section-head">
        <div>
          <p class="eyebrow">Riksdag Parties</p>
          <h2>The eight Riksdag parties</h2>
        </div>
        <p>Seat counts use the post-2022 Riksdag as the baseline for reading the pre-2026 political map.</p>
      </div>
      <div class="party-grid">
        {electionParties.map((party) => (
          <article class={`party-card tone-${party.tone}`}>
            <div class="party-mark">{party.shortName}</div>
            <div>
              <h3>{t(party.name, locale)}</h3>
              <p class="family">{t(party.family, locale)}</p>
              <p>{t(party.role, locale)}</p>
            </div>
            <strong>{party.seats2022} seats</strong>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="card">
    <div class="card-inner">
      <div class="section-head">
        <div>
          <p class="eyebrow">Issue Map</p>
          <h2>Four issue clusters to watch</h2>
        </div>
        <p>These are not isolated campaign themes; they are connected governing pressures.</p>
      </div>
      <div class="issue-grid">
        {electionIssues.map((issue) => (
          <article>
            <h3>{t(issue.title, locale)}</h3>
            <p>{t(issue.text, locale)}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="articles" class="card">
    <div class="card-inner">
      <div class="section-head">
        <div>
          <p class="eyebrow">Articles + Diagram Cards</p>
          <h2>Six launch articles, each with three diagram cards</h2>
        </div>
        <p>The cards are data-driven SVG/HTML explainers, so labels can switch language and factual text stays editable.</p>
      </div>
      <div class="article-grid">
        {articleCards.map((article, index) => (
          <a class="article-card" href={article.href}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{t(article.title, locale)}</h3>
            <p>{t(article.description, locale)}</p>
            <em>3 diagram cards</em>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="card">
    <div class="card-inner">
      <p class="eyebrow">Sources</p>
      <h2>Sources</h2>
      <div class="source-list">
        {electionSources.map((source) => (
          <a href={source.href} target="_blank" rel="noreferrer">{source.label}</a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .election-hero,
  .section-grid,
  .section-head {
    display: grid;
    gap: 22px;
  }

  .election-hero {
    grid-template-columns: minmax(0, 1fr) 320px;
    align-items: stretch;
  }

  .hero-copy,
  .date-panel {
    border: 1px solid var(--line);
    border-radius: 30px;
    background: linear-gradient(180deg, rgba(255, 253, 249, 0.98), rgba(246, 239, 229, 0.94));
    box-shadow: var(--shadow);
    padding: 34px;
  }

  h1 {
    font-size: clamp(2.7rem, 5vw, 5rem);
    max-width: 12ch;
    margin-bottom: 18px;
  }

  h2 {
    font-size: clamp(1.8rem, 3vw, 3rem);
  }

  .hero-copy p:not(.eyebrow),
  .section-head p,
  .section-grid p,
  .issue-grid p,
  .party-card p,
  .article-card p {
    color: var(--muted);
  }

  .date-panel {
    display: grid;
    align-content: center;
    gap: 14px;
  }

  .date-panel span {
    color: var(--page-accent);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .date-panel strong {
    font-family: var(--serif);
    font-size: clamp(2.2rem, 4vw, 4rem);
    line-height: 1;
  }

  .section-grid,
  .section-head {
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    align-items: end;
  }

  .party-grid,
  .issue-grid,
  .article-grid {
    display: grid;
    gap: 14px;
  }

  .party-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .party-card {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    gap: 14px;
    align-items: start;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: rgba(255, 253, 249, 0.74);
  }

  .party-mark {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--tone);
    font-weight: 800;
  }

  .party-card h3,
  .party-card p {
    margin: 0 0 6px;
  }

  .party-card strong {
    color: var(--page-accent);
    white-space: nowrap;
  }

  .family {
    font-weight: 700;
  }

  .tone-red { --tone: #d97968; }
  .tone-blue { --tone: #7ea6bd; }
  .tone-green { --tone: #97ad7b; }
  .tone-yellow { --tone: #d9b95e; }
  .tone-neutral { --tone: #d7cbbb; }

  .issue-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .issue-grid article,
  .article-card {
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: rgba(255, 253, 249, 0.74);
  }

  .issue-grid h3,
  .issue-grid p {
    margin: 0 0 8px;
  }

  .article-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .article-card {
    display: grid;
    gap: 10px;
    color: inherit;
    text-decoration: none;
  }

  .article-card span,
  .article-card em {
    color: var(--page-accent);
    font-style: normal;
    font-weight: 700;
  }

  .article-card h3,
  .article-card p {
    margin: 0;
  }

  .source-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .source-list a {
    padding: 10px 13px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--page-accent);
    text-decoration: none;
    font-weight: 700;
  }

  @media (max-width: 980px) {
    .election-hero,
    .section-grid,
    .section-head,
    .party-grid,
    .issue-grid,
    .article-grid {
      grid-template-columns: 1fr;
    }

    h1 {
      max-width: none;
    }
  }

  @media (max-width: 620px) {
    .hero-copy,
    .date-panel {
      padding: 24px;
      border-radius: 22px;
    }

    .party-card {
      grid-template-columns: 48px minmax(0, 1fr);
    }

    .party-card strong {
      grid-column: 2;
    }
  }
</style>
